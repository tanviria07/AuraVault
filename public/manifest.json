{
  "manifest_version": 3,
  "name": "AuraVault",
  "version": "0.1.0",
  "description": "Voice-controlled shopping assistant for AuraVault.",
  "permissions": ["offscreen", "storage"],
  "host_permissions": [
    "<all_urls>",
    "https://generativelanguage.googleapis.com/"
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ]
}
